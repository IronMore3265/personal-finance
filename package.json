{
  "name": "paisa",
  "version": "1.0.0",
  "private": true,
  "description": "Paisa - local-first multi-account, multi-currency finance tracker",
  "scripts": {
    "sync": "vite build && cap sync android",
    "open:android": "cap open android",
    "build:android": "vite build && cap sync android && android\\gradlew.bat -p android assembleDebug",
    "serve": "vite",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/calc.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run check && npm run test:unit && npm run test:browser",
    "shots": "playwright test visual",
    "icons": "node scripts/gen-icons.mjs",
    "build": "vite build"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-static": "^1.35.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
