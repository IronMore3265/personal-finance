{
  "name": "paisa",
  "version": "1.0.0",
  "private": true,
  "description": "Paisa - local-first multi-account, multi-currency finance tracker",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:android": "cap sync android && android\\gradlew.bat -p android assembleDebug",
    "serve": "node scripts/serve.js",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/calc.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run check && npm run test:unit && npm run test:browser",
    "shots": "playwright test visual",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.62.1",
    "lucide-static": "^1.35.0"
  }
}
